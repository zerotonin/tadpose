{
  "active_profile": "local",
  "profiles": {
    "local": {
      "data_root": "/path/to/your/tadpole_project",
      "code_root": "/path/to/your/checkout/tadpose",
      "python_interpreter": "python",
      "dlc_config_path": "/path/to/deeplabcut_models/single_tadpole/config.yaml",
      "sleap_predictions_root": "/path/to/SLEAP_2026_predictions/sept2024_pharmacology",
      "sleap_geometry_csv": "/path/to/SLEAP_2026_predictions/ring_geometry/sleap_well_geometry.csv",
      "sleap_output_root": "/path/to/results/sleap_2026"
    },
    "hpc": {
      "data_root": "/path/to/cluster/tadpole_project",
      "code_root": "/path/to/your/cluster/checkout/tadpose",
      "python_interpreter": "/path/to/conda/envs/deeplabcut/bin/python",
      "dlc_config_path": "/path/to/cluster/tadpole_project/models/dlc_single_tadpole/config.yaml",
      "db_path": "/path/to/cluster/tadpole_project/databases/your_db.sqlite3",
      "output_root": "/path/to/cluster/tadpole_project/results/pipeline/<batch>",
      "videos_root": "/path/to/cluster/tadpole_project/videos/raw/<batch>",
      "cluster_musigma": "/path/to/cluster/tadpole_project/cluster_analysis/sep18_canonical/canonical_k36_muSigma.csv",
      "cluster_centroids": "/path/to/cluster/tadpole_project/cluster_analysis/sep18_canonical/canonical_k36_centroids.npy",
      "conda_env": "deeplabcut",
      "partition": "<your-slurm-partition>",
      "account": "<your-slurm-account>",
      "sleap_predictions_root": "/path/to/cluster/tadpole_project/video_data/sleap_2026/sept2024_pharmacology",
      "sleap_geometry_csv": "/path/to/cluster/tadpole_project/video_data/sleap_2026/ring_geometry/sleap_well_geometry.csv",
      "sleap_output_root": "/path/to/cluster/tadpole_project/results/sleap_2026",
      "cpu_partition": "<your-cpu-slurm-partition>",
      "gpu_partitions": "<comma-separated GPU partitions>",
      "conda_sh": "/path/to/conda/etc/profile.d/conda.sh",
      "rapids_env": "<conda env with RAPIDS cuML>",
      "moseq_env": "<conda env with keypoint-moseq (JAX + CUDA 12)>",
      "moseq_gpu_partition": "<GPU partition for keypoint-MoSeq, large card>",
      "moseq_gpu_qos": "<QOS that partition demands, or empty>"
    }
  }
}
